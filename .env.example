# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================================
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_contraseña
POSTGRES_DB=tu_base_de_datos

# ==========================================
# SEGURIDAD Y DESPLIEGUE (CORS)
# ==========================================
# Para desarrollo local, deja solo localhost.
# Para producción, añade la IP de tu servidor separada por comas.
# Ejemplo: http://localhost:5173,http://51.92.195.7:5173
CORS_ORIGINS=http://localhost:5173

# ==========================================
# DATABASE POOL CONFIGURATION
# ==========================================
# Valores optimizados para el servidor de producción (Aumentar para test de carga en local)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
